{
  "name": "sinks",
  "version": "4.0.0",
  "description": "Tools for object sync (get it?!), validation, diffing, and immutable deep setting",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run format && npm run lint && npm test",
    "test-inspect": "node --inspect-brk --test src/main.spec.js",
    "test": "node --test src/*.spec.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "sync",
    "diff",
    "object",
    "immutable"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "src/basic-types.js",
    "src/deep-set.js",
    "src/index.js",
    "src/main.js",
    "src/utils.js"
  ],
  "devDependencies": {
    "eslint": "7.18.0",
    "prettier": "2.2.1",
    "prettier-plugin-jsdoc": "0.3.30"
  },
  "prettier": {
    "semi": false,
    "arrowParens": "avoid",
    "singleQuote": true,
    "jsdocParser": true
  },
  "dependencies": {
    "dlv": "1.1.3"
  }
}
